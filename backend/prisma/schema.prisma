// ── Campaign 2 (Google Form submissions) ───────────────────────────
// TODO: Replace these placeholder intake fields with Campaign 2's
// actual Google Form fields once finalized. The lifecycle fields
// (source/status/priority/pipelineStage/assignedTo/relations) stay as-is.

model Campaign2Lead {
  id                String       @id @default(cuid())
  // ── Campaign 2 Google Form intake fields ──
  studentName       String
  studentEmail      String
  studentMobile     String
  parentName        String?
  parentMobile      String?
  parentOccupation  String?
  preferredCountry  String?
  preferredIntake   String?
  currentQualification String?   // Highest Qualification
  completionYear    String?      // Education completion year
  percentage        String?
  course            String?      // Degree Name / course of interest
  mode              String?      // Office Visit / Google Meet
  city              String?
  budget            String?
  socialHandle      String?      // influencer / referral handle
  remarks           String?
  // ── lifecycle (shared) ──
  source            LeadSource   @default(GOOGLE_FORM)
  status            LeadStatus   @default(NEW)
  priority          Priority     @default(MEDIUM)
  followUpDate      DateTime?
  pipelineStage     PipelineStage @default(ENQUIRY)
  assignedTo        User?        @relation("Campaign2AssignedLeads", fields: [assignedToId], references: [id])
  assignedToId      String?
  activities        Campaign2LeadActivity[]
  tasks             Campaign2LeadTask[]
  communications    Campaign2LeadCommunication[]
  leadNotes         Campaign2LeadNote[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Campaign2LeadActivity {
  id        String   @id @default(cuid())
  type      String
  content   String
  lead      Campaign2Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model Campaign2LeadTask {
  id          String     @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean    @default(false)
  priority    Priority   @default(MEDIUM)
  lead        Campaign2Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?
  assignedTo  User       @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Campaign2LeadCommunication {
  id        String   @id @default(cuid())
  type      CommType
  subject   String?
  content   String
  status    String   @default("SENT")
  lead      Campaign2Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  createdAt DateTime @default(now())
}

model Campaign2LeadNote {
  id        String   @id @default(cuid())
  content   String
  lead      Campaign2Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}
